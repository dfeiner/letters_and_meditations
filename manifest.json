{
  "manifest_version": 3,
  "name": "Daily Stoic Quotes",
  "version": "1.0.0",
  "description": "Start each day with wisdom from the Stoics. Daily quotes from Marcus Aurelius, Epictetus, and Seneca.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
